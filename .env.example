# Copie para .env e ajuste. Todas as variáveis têm prefixo EVASAO_.

# Diretório base dos dados (raw/, staging/, warehouse/, reports/ são criados dentro dele)
EVASAO_DATA_DIR=./data

# Anos esperados da série histórica (usado para identificar anos ausentes)
EVASAO_EXPECTED_YEAR_START=2009
EVASAO_EXPECTED_YEAR_END=2024

# Modelo de URL oficial dos microdados (confirmado na página de dados abertos do INEP).
# {year} é substituído pelo ano. Só altere se o INEP mudar o padrão.
EVASAO_INEP_URL_TEMPLATE=https://download.inep.gov.br/microdados/microdados_censo_da_educacao_superior_{year}.zip
EVASAO_INEP_LISTING_URL=https://www.gov.br/inep/pt-br/acesso-a-informacao/dados-abertos/microdados/censo-da-educacao-superior

# Timeout de download em segundos
EVASAO_HTTP_TIMEOUT=120

# Opcional: PEM com a cadeia de CA (servidores Linux; o INEP envia cadeia incompleta).
# Sem isso, usa o repositório de certificados do sistema (truststore). Nunca desative a verificação.
# EVASAO_CA_BUNDLE=/etc/ssl/certs/inep-chain.pem

# API
# Origens permitidas para CORS, separadas por vírgula (ex.: http://localhost:5173,https://meusite.org)
EVASAO_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
EVASAO_API_HOST=127.0.0.1
EVASAO_API_PORT=8000

# Logs: DEBUG, INFO, WARNING, ERROR. Formato: json ou text
EVASAO_LOG_LEVEL=INFO
EVASAO_LOG_FORMAT=json
